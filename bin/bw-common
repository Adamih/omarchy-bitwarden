# Shared by the plugin's scripts; sourced, not run.

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy-bitwarden"
bindings="$HOME/.config/hypr/bindings.lua"
rbw_runtime_dir="${XDG_RUNTIME_DIR:-/run/user/$UID}/rbw${RBW_PROFILE:+-$RBW_PROFILE}"

# Commands the plugin runs, and the Arch packages that provide them.
declare -A required=(
  [rbw]=rbw
  [jq]=jq
  [wl-copy]=wl-clipboard
  [wl-paste]=wl-clipboard
  [pinentry-qt]=pinentry
  [gdbus]=glib2
  [systemd-inhibit]=systemd
)

# Prints each missing package once.
missing_packages() {
  local cmd
  for cmd in "${!required[@]}"; do
    command -v "$cmd" >/dev/null || echo "${required[$cmd]}"
  done | sort -u
}

# Whether rbw-agent is running, using builtins only: bw-guard calls this every 2s.
agent_running() {
  local pid
  [[ -r $rbw_runtime_dir/pidfile ]] || return 1
  read -r pid <"$rbw_runtime_dir/pidfile" 2>/dev/null || return 1
  [[ $pid =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null
}

has_keybind() {
  grep -q '^-- omarchy-bitwarden: begin' "$bindings" 2>/dev/null
}
